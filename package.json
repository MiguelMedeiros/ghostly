{
  "name": "ghostly",
  "private": true,
  "version": "1.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite apps/ui",
    "build": "tsc -b && vite build apps/ui",
    "preview": "vite preview apps/ui",
    "tauri": "tauri",
    "lint": "eslint apps/ui/src packages apps/extension/src apps/extension/test/*.ts apps/web/src apps/mini e2e",
    "lint:fix": "eslint apps/ui/src packages apps/extension/src apps/extension/test/*.ts apps/web/src apps/mini e2e --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && npm run typecheck -w @ghostly/core -w @ghostly/browser -w @ghostlytools/sdk -w @ghostly/extension -w @ghostly/web -w @ghostlytools/cli -w @ghostly/mini-chess",
    "test": "npm run test:packages && npm run test:app",
    "test:packages": "npm run test -w @ghostly/core -w @ghostly/browser -w @ghostlytools/sdk -w @ghostly/extension -w @ghostlytools/cli -w @ghostly/mini-chess",
    "test:app": "npm run test:ui && npm run test:matrix && npm run test:scripts",
    "test:affected": "node tools/scripts/test-affected.mjs",
    "test:ui": "vitest run -c apps/ui/vitest.ui.config.ts",
    "test:matrix": "vitest run -c e2e/matrix/vitest.config.ts",
    "test:scripts": "vitest run -c tools/scripts/vitest.config.ts",
    "locales:sort": "node tools/scripts/locales-sort.mjs",
    "test:map": "node tools/scripts/test-map.mjs",
    "test:map:write": "node tools/scripts/test-map.mjs --write",
    "coverage": "node tools/scripts/coverage.mjs",
    "build:extension": "npm run build -w @ghostly/extension",
    "test:e2e": "npm run build:extension && playwright test -c e2e/playwright.config.ts",
    "test:e2e:offline": "npm run test:e2e -- --grep-invert @network",
    "test:e2e:ui": "npm run build:extension && playwright test -c e2e/playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:desktop": "playwright test -c e2e/playwright.desktop.config.ts",
    "test:e2e:compat": "playwright test -c e2e/playwright.compat.config.ts",
    "test:e2e:webkit": "playwright test -c e2e/playwright.webkit.config.ts",
    "test:e2e:desktop-macos": "playwright test -c e2e/playwright.desktop-macos.config.ts",
    "desktop:macos:build": "tauri build --debug --bundles app --features e2e-driver --config apps/desktop/tauri.e2e.conf.json",
    "e2e:matrix": "node tools/scripts/e2e-matrix.mjs",
    "e2e:matrix:docs": "node tools/scripts/matrix-docs.mjs",
    "e2e:matrix:table": "MATRIX_WRITE=1 vitest run -c e2e/matrix/vitest.config.ts table",
    "e2e:infra:up": "node e2e/infra/infra.mjs up",
    "e2e:infra:down": "node e2e/infra/infra.mjs down",
    "e2e:infra:reset": "node e2e/infra/infra.mjs reset",
    "e2e:infra:status": "node e2e/infra/infra.mjs status",
    "e2e:infra:use": "node e2e/infra/infra.mjs use",
    "e2e:infra:seed": "node e2e/infra/infra.mjs seed",
    "e2e:full": "node e2e/infra/infra.mjs full",
    "build:web": "npm run build -w @ghostly/web",
    "check:desktop-bundle": "node tools/scripts/check-desktop-bundle.mjs",
    "check:wkwebview-media": "node tools/scripts/voice-media/check-wkwebview.mjs",
    "postinstall": "patch-package --patch-dir tools/patches",
    "build:sdk": "npm run build -w @ghostlytools/sdk",
    "test:sdk-example": "node tools/scripts/sdk-example.mjs",
    "test:group-load": "GROUP_LOAD=${GROUP_LOAD:-256} npm run test:group-load -w @ghostly/browser"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@emoji-mart/data": "^1.2.1",
    "@ghostly/browser": "*",
    "@ghostly/core": "*",
    "@ghostly/react": "*",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip39": "^2.4.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "jsqr": "^1.4.0",
    "lowlight": "^3.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@web5/dids": "1.2.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "patch-package": "8.0.1",
    "playwright": "^1.63.0",
    "solc": "0.8.37",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "workspaces": [
    "packages/*",
    "apps/extension",
    "apps/mini/*",
    "apps/web"
  ],
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
