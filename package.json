{
  "name": "ghostly",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src packages extension/src extension/test/*.ts web/src e2e examples/sdk-adapter/src examples/sdk-adapter/test",
    "lint:fix": "eslint src packages extension/src extension/test/*.ts web/src e2e examples/sdk-adapter/src examples/sdk-adapter/test --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && npm run typecheck -w @ghostly/core -w @ghostly/browser -w @ghostly/sdk -w @ghostly/extension -w @ghostly/web",
    "test": "npm run test -w @ghostly/core -w @ghostly/browser -w @ghostly/sdk -w @ghostly/extension && npm run test:ui && npm run test:matrix",
    "test:ui": "vitest run -c vitest.ui.config.ts",
    "test:matrix": "vitest run -c e2e/matrix/vitest.config.ts",
    "test:map": "node scripts/test-map.mjs",
    "test:map:write": "node scripts/test-map.mjs --write",
    "coverage": "node scripts/coverage.mjs",
    "build:extension": "npm run build -w @ghostly/extension",
    "test:interop": "npm run test:interop -w @ghostly/core",
    "test:e2e": "npm run build:extension && playwright test -c e2e/playwright.config.ts",
    "test:e2e:offline": "npm run test:e2e -- --grep-invert @network",
    "test:e2e:ui": "npm run build:extension && playwright test -c e2e/playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:desktop": "playwright test -c e2e/playwright.desktop.config.ts",
    "e2e:matrix": "node scripts/e2e-matrix.mjs",
    "e2e:matrix:docs": "node scripts/matrix-docs.mjs",
    "e2e:matrix:table": "MATRIX_WRITE=1 vitest run -c e2e/matrix/vitest.config.ts table",
    "e2e:infra:up": "node e2e/infra/infra.mjs up",
    "e2e:infra:down": "node e2e/infra/infra.mjs down",
    "e2e:infra:reset": "node e2e/infra/infra.mjs reset",
    "e2e:infra:status": "node e2e/infra/infra.mjs status",
    "e2e:infra:use": "node e2e/infra/infra.mjs use",
    "e2e:full": "node e2e/infra/infra.mjs full",
    "build:web": "npm run build -w @ghostly/web",
    "check:desktop-bundle": "node scripts/check-desktop-bundle.mjs",
    "postinstall": "patch-package",
    "build:sdk": "npm run build -w @ghostly/sdk",
    "test:sdk-example": "node scripts/sdk-example.mjs",
    "test:group-load": "GROUP_LOAD=${GROUP_LOAD:-256} npm run test:group-load -w @ghostly/browser"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@ghostly/browser": "*",
    "@ghostly/core": "*",
    "@ghostly/react": "*",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "emoji-mart": "^5.6.0",
    "jsqr": "^1.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "patch-package": "8.0.1",
    "playwright": "^1.63.0",
    "solc": "0.8.37",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "workspaces": [
    "packages/*",
    "extension",
    "web"
  ],
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
