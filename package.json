{
  "name": "ghostly",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src packages extension/src web/src",
    "lint:fix": "eslint src packages extension/src web/src --fix",
    "typecheck": "tsc --noEmit && npm run typecheck -w @ghostly/core -w @ghostly/browser -w @ghostly/extension -w @ghostly/web",
    "test": "npm run test -w @ghostly/core",
    "build:extension": "npm run build -w @ghostly/extension",
    "test:interop": "npm run test:interop -w @ghostly/core",
    "test:e2e": "npm run build -w @ghostly/extension && npm run test:e2e -w @ghostly/extension",
    "build:web": "npm run build -w @ghostly/web"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@tauri-apps/api": "^2.11.1",
    "emoji-mart": "^5.6.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "@ghostly/core": "*",
    "@ghostly/react": "*",
    "@ghostly/browser": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/vite": "^4.2.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "playwright": "^1.58.2",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^7.3.1"
  },
  "workspaces": [
    "packages/*",
    "extension",
    "web"
  ]
}
