{
  "name": "ghostly",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src packages extension/src web/src e2e",
    "lint:fix": "eslint src packages extension/src web/src e2e --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && npm run typecheck -w @ghostly/core -w @ghostly/browser -w @ghostly/extension -w @ghostly/web",
    "test": "npm run test -w @ghostly/core -w @ghostly/browser",
    "build:extension": "npm run build -w @ghostly/extension",
    "test:interop": "npm run test:interop -w @ghostly/core",
    "test:e2e": "npm run build:extension && playwright test -c e2e/playwright.config.ts",
    "test:e2e:offline": "npm run test:e2e -- --grep-invert @network",
    "test:e2e:ui": "npm run build:extension && playwright test -c e2e/playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:desktop": "playwright test -c e2e/playwright.desktop.config.ts",
    "build:web": "npm run build -w @ghostly/web",
    "check:desktop-bundle": "node scripts/check-desktop-bundle.mjs"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@ghostly/browser": "*",
    "@ghostly/core": "*",
    "@ghostly/react": "*",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "emoji-mart": "^5.6.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "workspaces": [
    "packages/*",
    "extension",
    "web"
  ]
}
