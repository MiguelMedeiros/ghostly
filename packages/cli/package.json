    "@ghostly/browser": "*",
    "@ghostly/core": "*",
    "@ghostly/iroh-web": "*",
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
