{
  "name": "Ghostly",
  "short_name": "Ghostly",
  "description": "Chat, calls, files, sats and your localhost apps, peer to peer. It all exists while you are online.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#111b21",
  "theme_color": "#202c33",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New chat", "short_name": "New chat", "description": "Start a chat and get its invite", "url": "/#/new", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Scan invite", "short_name": "Scan", "description": "Join a chat from its QR code", "url": "/#/scan", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Wallets", "short_name": "Wallets", "description": "Your wallets and payments", "url": "/#/wallet", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["*/*"] }]
    }
  },
  "protocol_handlers": [
    { "protocol": "web+ghostly", "url": "/#%s" }
  ]
}
