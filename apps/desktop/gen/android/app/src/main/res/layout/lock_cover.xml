<?xml version="1.0" encoding="utf-8"?>
<!--
  Over the page while the lock screen is on and the app is not in front (MainActivity): the app's mark and one line,
  nothing of the page. Its background and the line's colour are the page's (MainActivity.updateCover). In the upper
  part, not the middle: Android's permission prompt shows over it in the middle of the screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lock_cover"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:importantForAccessibility="noHideDescendants"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="64dp"
    android:paddingEnd="32dp">

    <ImageView
        android:id="@+id/lock_cover_mark"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="@null"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/lock_cover_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/lock_cover"
        android:textAppearance="?attr/textAppearanceBodyLarge" />
</LinearLayout>
