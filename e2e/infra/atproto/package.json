{
  "name": "ghostly-e2e-atproto",
  "private": true,
  "description": "A local AT Protocol network for the e2e suite: a PLC directory (in memory) and a reference PDS with test accounts.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs"
  },
  "dependencies": {
    "@atproto/crypto": "0.5.7",
    "@atproto/pds": "0.5.52",
    "@did-plc/server": "0.0.1"
  },
  "overrides": {
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/propagator-jaeger": "2.12.0",
    "glob": "14.0.2",
    "kysely": "0.29.6",
    "minimatch": "11.0.3",
    "nodemailer": "10.1.4"
  }
}
