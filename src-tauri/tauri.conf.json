{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Ghostly",
  "version": "0.4.0",
  "identifier": "app.ghostly.chat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node scripts/prepare-native-runtime.mjs && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ghostly \u2014 Ephemeral Encrypted Chat",
        "width": 900,
        "height": 700,
        "minWidth": 400,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://media.giphy.com https://media0.giphy.com https://media1.giphy.com https://media2.giphy.com https://media3.giphy.com https://media4.giphy.com https://giphy.com https://web.archive.org blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https: wss: ws:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MiguelMedeiros/ghostly/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0NkY4MkFDNUMzQjQzQjcKUldTM1F6dGNySUp2ZE1xRUxaY0FqemxDMm5mK215WndRQjVtTTA2OFlMM2thdldVbStpTzJQTysK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "native-runtime/": "native-runtime/"
    }
  }
}
